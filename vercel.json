{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "headers": [
    { "source": "/r/(.*).md", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }] },
    { "source": "/search-index.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
