---
import type { Framed, ViewRow } from '../../lib/recipes';
import type { Terms } from '../../lib/terms';
import { sentence } from '../../lib/markdown';

interface Props { views: Framed<ViewRow>; terms: Terms }
const { views, terms } = Astro.props;
const { render, renderInline, strong } = terms;
// Consecutive views opened at the same moment share one cadence line.
const groups: { when: string; rows: ViewRow[] }[] = [];
for (const row of views.items) {
  const last = groups[groups.length - 1];
  if (last && row.when && last.when === row.when) last.rows.push(row);
  else groups.push({ when: row.when, rows: [row] });
}
---
{views.intro && <div class="lede" set:html={render(views.intro)} />}
<div class="looks">
  {groups.map((g) => (
    <div class="look">
      {g.when && <p class="cadence" set:html={renderInline(g.when)} />}
      <ul>
        {g.rows.map((row) => (
          <li>{row.view && <Fragment set:html={strong(row.view)} />}{row.kind && <span class="kind"> {row.kind}</span>}{row.answers && <Fragment set:html={`${row.view || row.kind ? ' <span class="sep">—</span> ' : ''}${renderInline(sentence(row.answers))}`} />}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
{views.outro && <Fragment set:html={render(views.outro)} />}
