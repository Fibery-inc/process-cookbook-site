---
import type { Framed, Question } from '../../lib/recipes';
import { render, renderInline } from '../../lib/markdown';
import { allDefaults } from '../../lib/setup';

interface Props {
  questions: Framed<Question>;
  adaptations: { name: string; text: string }[] | null;
  claudeUrl: string;
}
const { questions, adaptations, claudeUrl } = Astro.props;
const lowerFirst = (s: string) => s.replace(/^([A-Z])(?=[a-z\s'’])/, (c) => c.toLowerCase());
const sentence = (s: string) => (/[.?!]["”’)*_]*$/.test(s.trim()) ? s.trim() : `${s.trim()}.`);
const word = (label: string) => label.split(/[\s,]/)[0].toLowerCase();
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const note = (lead: string, md: string) => `<b>${escape(lead)}</b> ${renderInline(sentence(lowerFirst(md)))}`;
---
{questions.intro && <div class="lede" set:html={render(questions.intro)} />}
<div class="choices" data-choices>
  {questions.items.map((q, i) => (
    <div class="choice" data-text={q.text} data-change={q.change}>
      <div class="q">
        <p class="q-text" id={`choice-${i}`}>{q.text}</p>
        <p class="q-note">
          {q.defaultNote && <Fragment set:html={note(q.yesNo ? `If ${word(q.defaultLabel)},` : 'By default,', q.defaultNote) + ' '} />}
          <Fragment set:html={note(q.yesNo ? `If ${word(q.otherLabel)},` : 'Otherwise,', q.otherNote)} />
        </p>
      </div>
      <div class="q-pick" role="group" aria-labelledby={`choice-${i}`}>
        <button type="button" data-answer="default" data-label={q.defaultLabel} aria-pressed="true">{q.defaultLabel}</button>
        <button type="button" data-answer="other" data-label={q.otherLabel} aria-pressed="false">{q.otherLabel}</button>
      </div>
    </div>
  ))}
  <div class="choices-foot">
    <span data-answers-summary aria-live="polite">{allDefaults(questions.items.length)}</span>
    <a data-chat="claude" href={claudeUrl} target="_blank" rel="noopener">Set it up with these answers →</a>
  </div>
</div>
{adaptations && adaptations.length > 0 && (
  <details class="also">
    <summary>Also common: {adaptations.map((a) => a.name).join(' · ')}</summary>
    <ul>
      {adaptations.map((a) => <li set:html={render(a.text)} />)}
    </ul>
  </details>
)}
{questions.outro && <Fragment set:html={render(questions.outro)} />}
