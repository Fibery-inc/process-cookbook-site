---
export type TocEntry = { id: string; label: string; folded?: boolean };
interface Props { entries: TocEntry[]; heading?: boolean }
const { entries, heading = true } = Astro.props;
---
<nav class="toc" aria-label="On this page">
  {heading && <p class="eyebrow">On this page</p>}
  {entries.map((e) => (
    <a href={`#${e.id}`} data-toc={e.id}>
      <span>{e.label}</span>
      {e.folded && <span class="folded">folded</span>}
    </a>
  ))}
</nav>
