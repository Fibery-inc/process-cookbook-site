---
import type { Framed, Rule } from '../../lib/recipes';
import type { Terms } from '../../lib/terms';
import { sentence } from '../../lib/markdown';

interface Props { rules: Framed<Rule>; terms: Terms }
const { rules, terms } = Astro.props;
const { render, renderInline, strong } = terms;
---
{rules.intro && <div class="lede" set:html={render(rules.intro)} />}
<ul class="rule-list">
  {rules.items.map((x) => (
    <li set:html={`${strong(x.name)}${x.when ? ` <span class="trigger">(${renderInline(x.when)})</span>` : ''}: ${renderInline(sentence(x.does))}`} />
  ))}
</ul>
{rules.outro && <div class="lede" set:html={render(rules.outro)} />}
