---
import type { Terms } from '../../lib/terms';

interface Props { terms: Terms }
const { terms } = Astro.props;
---
<dl class="words">
  {terms.words.map((w) => (
    <div>
      <dt class={`term w${w.color}`}>{w.name}</dt>
      {w.definition && <dd set:html={terms.renderInline(w.definition)} />}
    </div>
  ))}
</dl>
