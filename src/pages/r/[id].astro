---
import Base from '../../layouts/Base.astro';
import Steps from '../../components/recipe/Steps.astro';
import Views from '../../components/recipe/Views.astro';
import Rules from '../../components/recipe/Rules.astro';
import Promises from '../../components/recipe/Promises.astro';
import Choices from '../../components/recipe/Choices.astro';
import Words from '../../components/recipe/Words.astro';
import Toc, { type TocEntry } from '../../components/recipe/Toc.astro';
import { recipes, byDomain, FOR_LABELS, formatDate, domainLabel, HUMAN_SECTIONS, sectionId, promiseParts, modelSummary, stepFolds } from '../../lib/recipes';
import { render, renderInline } from '../../lib/markdown';
import { wordTerms } from '../../lib/terms';
import { TOOLS, TOOL_KEY, FIBERY_CHATGPT_APP, setupPrompt, claudeLink, chatgptLink } from '../../lib/setup';
import claudeSvg from '../../icons/claude.svg?raw';
import chatgptSvg from '../../icons/chatgpt.svg?raw';

export function getStaticPaths() {
  return recipes.map((r) => ({ params: { id: r.id }, props: { recipe: r } }));
}
// Whatever SVG sits in src/icons is drawn 16px and hidden from screen readers; a mark with its own fill keeps
// its color, one without takes the button's.
const icon = (svg: string) =>
  svg
    .replace(/<title>[\s\S]*?<\/title>/, '')
    .replace(/<svg\b([^>]*)>/, (_, attrs: string) => {
      const fill = /\sfill=("[^"]*"|'[^']*')/.test(attrs) ? '' : ' fill="currentColor"';
      return `<svg${attrs.replace(/\s(?:width|height|role|aria-hidden|focusable)=("[^"]*"|'[^']*')/g, '')} width="16" height="16"${fill} aria-hidden="true" focusable="false">`;
    });
const { recipe: r } = Astro.props;
const p = r.parsed;
const terms = wordTerms(p?.words);

const sections = HUMAN_SECTIONS.filter((h) => r.sections[h]).map((h) => ({ h, id: sectionId(h) }));
const details = r.sections['Details for building'] ? terms.render(r.sections['Details for building']) : '';
const sources = r.sections['Sources'] ? render(r.sections['Sources']) : '';
const { bold, rest } = promiseParts(r);
const creditHtml = r.footer ? render(r.footer) : '';
const related = byDomain(r.domain).filter((x) => x.id !== r.id).slice(0, 3);
const fallback = recipes.filter((x) => x.id !== r.id && x.for === r.for).slice(0, 3 - related.length);
const relatedAll = [...related, ...fallback];
const stepsFold = !!p?.steps?.items.some(stepFolds);
const summaryLine = modelSummary(r);
const modelLine = `The model for builders and agents${summaryLine ? `: ${summaryLine}` : ''}. The story above is enough to run the process.`;
const facts = [r.roles, r.needs].filter(Boolean).length;

const toc: TocEntry[] = [
  ...(terms.words.length ? [{ id: 'the-words', label: 'The words' }] : []),
  ...sections.map(({ h, id }) => ({ id, label: h })),
  ...(details ? [{ id: 'details-for-building', label: 'Details for building', folded: true }] : []),
  ...(sources ? [{ id: 'sources', label: 'Sources' }] : []),
  { id: 'build-it', label: 'Build it' },
];

const audience = r.for === 'community' ? 'groups' : r.for === 'company' ? 'companies' : 'teams';
const site = Astro.site?.toString().replace(/\/$/, '') || '';
const pageUrl = `${site}/r/${r.id}`;
const mdUrl = `${site}/r/${r.id}.md`;
// Every tool's links, so the inline script can show the remembered tool's before the page script loads.
const runLinks = Object.fromEntries(
  TOOLS.map((t) => {
    const prompt = setupPrompt(t.id, r.title, mdUrl);
    return [t.id, { prompt, claude: claudeLink(prompt), chatgpt: chatgptLink(setupPrompt(t.id, r.title, mdUrl, '', 'chatgpt')) }];
  }),
);
const { prompt, claude: claudeUrl, chatgpt: chatgptUrl } = runLinks[TOOLS[0].id];
const fiberyUrl = `https://fibery.com/?utm_source=processcookbook.org&utm_medium=site&utm_campaign=recipe-run-it&utm_content=${r.id}`;
const fiberyPlugin = 'https://github.com/Fibery-inc/skills#install';
const questionCount = p?.questions?.items.length ?? 0;
const defaultsLine = questionCount === 1 ? 'Default for the 1 question' : `Defaults for the ${questionCount} questions`;
const description = r.summary;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${r.title}: how ${audience} run it`,
  description,
  url: pageUrl,
  dateModified: r.updated,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  publisher: { '@type': 'Organization', name: 'Process Cookbook', url: site },
  keywords: r.keywords.join(', '),
  about: domainLabel(r.domain),
};
const notes: Record<string, string> = {
  fibery: 'Claude asks a few questions, then builds it in about ten minutes: the databases, the views, the rules and sample records.',
  airtable: 'Your assistant builds the base from Details for building: a table per database, linked records and the views.',
  notion: 'Your assistant builds the databases with relations and rollups; the rules become reminders and templates.',
  lovable: 'Your assistant generates an app from Details for building: the tables, the views as pages, the rules as logic.',
  other: 'Name your tool in the chat; the model uses words most tools can map, and the story is enough to run it on paper.',
};
---
<Base title={`${r.title}: how ${audience} run it · Process Cookbook`} description={description} canonical={pageUrl} jsonLd={jsonLd} ogType="article">
  <section class:list={['title-block', { 'with-facts': facts > 0 }]}>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/recipes">Recipes</a><span>/</span><a href={`/d/${r.domain}`}>{domainLabel(r.domain)}</a><span>/</span><span class="here">{r.title}</span>
      </nav>
      <div class="tag-row">
        <a class="tag" data-domain={r.domain} href={`/d/${r.domain}`}>{r.domain}</a>
        <span class="tag plain">{FOR_LABELS[r.for] || r.for}</span>
      </div>
      <h1>{r.title}</h1>
      <p class="promise">
        {bold && <strong set:html={renderInline(bold)} />}
        {rest && <span class="rest" set:html={' ' + renderInline(rest)} />}
      </p>
      {facts > 0 && (
        <div class="facts" style={`--facts: ${facts}`}>
          {r.roles && (
            <div class="fact"><p class="label">Who runs it</p><p class="text" set:html={terms.renderInline(r.roles)} /></div>
          )}
          {r.needs && (
            <div class="fact"><p class="label">What you need</p><p class="text" set:html={terms.renderInline(r.needs)} /></div>
          )}
        </div>
      )}
      <p class="meta">
        <span>Updated {formatDate(r.updated)}</span>
        <a class="gh" href={r.github}>
          <svg width="16" height="16" viewBox="0 0 16 16" role="img" aria-label="GitHub"><circle cx="4" cy="3.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle><circle cx="4" cy="12.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle><circle cx="12" cy="5.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M4 5.3v5.4M12 7.3c0 2.2-2 3-5 3.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
          Source and history on GitHub
        </a>
        <a href={`/r/${r.id}.md`}>Markdown</a>
      </p>
    </div>
  </section>

  <div class="wrap recipe-body">
    <article class="article">
      {terms.words.length > 0 && (
        <section id="the-words" class="part">
          <h2>The words</h2>
          <Words terms={terms} />
        </section>
      )}

      {sections.map(({ h, id }) => (
        <section id={id} class="part">
          {h === 'How it runs' && p?.steps && stepsFold ? (
            <div class="part-head">
              <h2>{h}</h2>
              <button type="button" class="pill" data-steps-toggle aria-expanded="false" hidden>Open all steps</button>
            </div>
          ) : (
            <h2>{h}</h2>
          )}
          {h === 'How it runs' && p?.steps ? (
            <Steps steps={p.steps} terms={terms} />
          ) : h === 'What people look at' && p?.views ? (
            <Views views={p.views} terms={terms} />
          ) : h === 'The rules' && p?.rules ? (
            <Rules rules={p.rules} terms={terms} />
          ) : h === 'What must stay true' && p?.promises ? (
            <Promises promises={p.promises} terms={terms} />
          ) : h === 'Making it yours' && p?.questions ? (
            <Choices questions={p.questions} adaptations={p.adaptations} claudeUrl={claudeUrl} terms={terms} />
          ) : (
            <Fragment set:html={terms.render(r.sections[h])} />
          )}
        </section>
      ))}

      {details && (
        <section id="details-for-building" class="model">
          <details data-model>
            <summary>
              <h2>Details for building</h2>
              <span class="btn solid sm model-toggle" aria-hidden="true"><span class="when-closed">Open the model here</span><span class="when-open">Fold the model</span></span>
              <span class="model-line">{modelLine}</span>
            </summary>
            <div class="model-content">
              <Fragment set:html={details} />
              <button type="button" class="btn sm" data-model-fold hidden>Fold the model</button>
            </div>
          </details>
          <a class="btn sm model-page" href={`/r/${r.id}/build`}>Open as its own page</a>
        </section>
      )}

      {sources && (
        <section id="sources" class="part sources">
          <h2>Sources</h2>
          <Fragment set:html={sources} />
        </section>
      )}

      <section id="build-it" class="part build">
        <h2>Build it</h2>
        <p>Pick your tool in the Run it box and give this recipe to your AI assistant, or build it by hand from Details for building. The story above is enough to run the process without any tool at all.</p>
        {creditHtml && <div class="credit" set:html={creditHtml} />}
      </section>
    </article>

    <aside class="rail" id="rail">
      <div class="rail-zone">
        <div class="rail-sticky">
          <div class="runit" id="run-it" data-md-url={mdUrl} data-title={r.title} data-tool-key={TOOL_KEY} data-links={JSON.stringify(runLinks)}>
            <h2><label for="runit-tool">Run it in your tool</label></h2>
            <select id="runit-tool" class="input runit-tool" data-tool-select>
              {TOOLS.map((t) => <option value={t.id}>{t.label}</option>)}
            </select>
            {TOOLS.map((t, i) => <p class="note" data-for-tool={t.id} hidden={i !== 0}>{notes[t.id]}</p>)}
            <p class="needs" data-for-tool="fibery">Needs a <a href={fiberyUrl} target="_blank" rel="noopener">Fibery</a> workspace and the <a href={fiberyPlugin} target="_blank" rel="noopener">Fibery plugin in Claude</a>, or the <a href={FIBERY_CHATGPT_APP} target="_blank" rel="noopener">Fibery app in ChatGPT</a>, set up once.</p>
            <div class="setup">
              <p class="setup-label" id="setup-with">Set it up with</p>
              <div class="row" role="group" aria-labelledby="setup-with">
                <a class="btn solid block" data-chat="claude" href={claudeUrl} target="_blank" rel="noopener"><Fragment set:html={icon(claudeSvg)} />Claude</a>
                <a class="btn block" data-chat="chatgpt" href={chatgptUrl} target="_blank" rel="noopener"><Fragment set:html={icon(chatgptSvg)} />ChatGPT</a>
              </div>
              <div class="prompt-tools">
                <button type="button" class="link-btn copy" data-copy-prompt aria-live="polite"><span class="idle">Copy the prompt</span><span class="done">Copied</span></button>
                <button type="button" class="link-btn" data-show-prompt aria-expanded="false" aria-controls="runit-prompt">Show the prompt</button>
              </div>
              <p class="prompt-text" id="runit-prompt" hidden>{prompt}</p>
              {p?.questions && (
                <p class="answers-line"><span data-answers-line>{defaultsLine}</span> · <a href="#making-it-yours">change</a></p>
              )}
            </div>
            <p class="small muted">Opens a chat with this recipe and your tool already named.</p>
            <div class="links">
              <button type="button" class="link-btn copy" data-copy-md={`/r/${r.id}.md`} aria-live="polite"><span class="idle">Copy as Markdown</span><span class="done">Copied</span></button>
              <a href={r.github}>View on GitHub</a>
            </div>
          </div>
          <script is:inline>
            // Shows the tool picked last time before the card is painted; the page script takes over from there.
            (function () {
              var card = document.getElementById('run-it');
              var links = JSON.parse(card.dataset.links);
              var tool = null;
              try { tool = localStorage.getItem(card.dataset.toolKey); } catch (e) {}
              if (!tool || !Object.prototype.hasOwnProperty.call(links, tool)) return;
              window.__runItTool = function () {
                var l = links[tool];
                document.querySelectorAll('[data-tool-select]').forEach(function (s) { s.value = tool; });
                document.querySelectorAll('[data-for-tool]').forEach(function (n) { n.hidden = n.dataset.forTool !== tool; });
                document.querySelectorAll('[data-chat="claude"]').forEach(function (a) { a.href = l.claude; });
                document.querySelectorAll('[data-chat="chatgpt"]').forEach(function (a) { a.href = l.chatgpt; });
                document.getElementById('runit-prompt').textContent = l.prompt;
              };
              window.__runItTool();
            })();
          </script>
          <Toc entries={toc} />
        </div>
      </div>

      {relatedAll.length > 0 && (
        <div class="related">
          <p class="eyebrow">Related recipes</p>
          {relatedAll.map((x) => (
            <a class="item" href={`/r/${x.id}`}><span class="t">{x.title}</span><span class="s">{x.domain} · {FOR_LABELS[x.for] || x.for}</span></a>
          ))}
          <p class="small muted">Something missing? <a href="https://github.com/Fibery-inc/process-cookbook/issues/new">Suggest a change</a> or <a href="/#requested">request a recipe</a>.</p>
        </div>
      )}
    </aside>
  </div>

  <div class="phone-bar">
    <button type="button" class="pb-contents" data-open-toc aria-haspopup="dialog" aria-controls="toc-sheet" aria-label="Contents">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12M4 10h8M4 15h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>
    <label class="sr-only" for="pb-tool">Your tool</label>
    <select id="pb-tool" class="pb-tool" data-tool-select>
      {TOOLS.map((t) => <option value={t.id}>{t.label}</option>)}
    </select>
    <a class="btn solid pb-claude" data-chat="claude" href={claudeUrl} target="_blank" rel="noopener">Set it up with Claude</a>
  </div>
  <script is:inline>window.__runItTool && window.__runItTool();</script>

  <dialog id="toc-sheet" class="sheet" aria-labelledby="toc-sheet-title">
    <div class="sheet-inner">
      <div class="sheet-head">
        <p class="eyebrow" id="toc-sheet-title">On this page</p>
        <form method="dialog">
          <button class="sheet-close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </form>
      </div>
      <Toc entries={toc} heading={false} />
    </div>
  </dialog>

  <script>
    import { TOOLS, TOOL_KEY, allDefaults, setupPrompt, claudeLink, chatgptLink } from '../../lib/setup';

    const runIt = document.getElementById('run-it');
    const mdUrl = runIt?.dataset.mdUrl || '';
    const title = runIt?.dataset.title || '';
    const choices = [...document.querySelectorAll<HTMLElement>('[data-choices] .choice')];
    const answers: ('default' | 'other')[] = choices.map(() => 'default');
    const promptText = document.getElementById('runit-prompt');
    const showPrompt = document.querySelector<HTMLButtonElement>('[data-show-prompt]');
    const answersLine = document.querySelector<HTMLElement>('[data-answers-line]');
    const defaultsLine = answersLine?.textContent || '';
    let tool = document.querySelector<HTMLSelectElement>('#runit-tool')?.value || TOOLS[0].id;
    let prompt = '';
    let answered = false;

    function answersText() {
      if (!answered) return '';
      const lines = choices.map((c, i) => {
        const label = c.querySelector<HTMLElement>(`[data-answer="${answers[i]}"]`)?.dataset.label || '';
        return `${c.dataset.text} ${label}${answers[i] === 'default' ? ' (the default)' : ''}.`;
      });
      return `My answers to its Making it yours questions: ${lines.join(' ')}`;
    }

    function summary() {
      const changed = choices.filter((_, i) => answers[i] === 'other').map((c) => c.dataset.change);
      return changed.length ? `Defaults, except: ${changed.join('; ')}.` : allDefaults(choices.length);
    }

    function update() {
      const extra = answersText();
      prompt = setupPrompt(tool, title, mdUrl, extra);
      const chatgpt = chatgptLink(setupPrompt(tool, title, mdUrl, extra, 'chatgpt'));
      document.querySelectorAll<HTMLAnchorElement>('[data-chat="claude"]').forEach((a) => (a.href = claudeLink(prompt)));
      document.querySelectorAll<HTMLAnchorElement>('[data-chat="chatgpt"]').forEach((a) => (a.href = chatgpt));
      if (promptText) promptText.textContent = prompt;
      const text = summary();
      document.querySelectorAll('[data-answers-summary]').forEach((el) => (el.textContent = text));
      if (answersLine) {
        const changed = choices.filter((_, i) => answers[i] === 'other').map((c) => c.dataset.change);
        answersLine.textContent = changed.length ? `Your answers: ${changed.join(', ')}` : defaultsLine;
      }
    }

    function pickTool(id: string) {
      tool = id;
      try {
        localStorage.setItem(TOOL_KEY, id);
      } catch {
        // Storage off or full: the choice lasts for this page only.
      }
      document.querySelectorAll<HTMLElement>('[data-for-tool]').forEach((n) => (n.hidden = n.dataset.forTool !== id));
      document.querySelectorAll<HTMLSelectElement>('[data-tool-select]').forEach((s) => (s.value = id));
      update();
    }

    document.querySelectorAll<HTMLSelectElement>('[data-tool-select]').forEach((s) => s.addEventListener('change', () => pickTool(s.value)));
    update();

    const timers = new WeakMap<HTMLElement, number>();
    function flashCopied(button: HTMLElement) {
      button.dataset.copied = '';
      clearTimeout(timers.get(button));
      timers.set(button, window.setTimeout(() => delete button.dataset.copied, 2000));
    }

    function revealPrompt(open: boolean) {
      if (!promptText || !showPrompt) return;
      promptText.hidden = !open;
      showPrompt.setAttribute('aria-expanded', String(open));
      showPrompt.textContent = open ? 'Hide the prompt' : 'Show the prompt';
    }
    showPrompt?.addEventListener('click', () => revealPrompt(!!promptText?.hidden));

    // Without a clipboard the prompt opens, selected, for copying by hand.
    document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) =>
      button.addEventListener('click', async () => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error('no clipboard');
          await navigator.clipboard.writeText(prompt);
          flashCopied(button);
        } catch {
          revealPrompt(true);
          if (promptText) getSelection()?.selectAllChildren(promptText);
        }
      }),
    );

    // The file is fetched as soon as someone reaches for the button: Safari allows a clipboard write only
    // within the click itself, so the text has to be ready by then. Without a clipboard, the file opens.
    document.querySelectorAll<HTMLButtonElement>('[data-copy-md]').forEach((button) => {
      const url = button.dataset.copyMd!;
      let file: Promise<string> | null = null;
      let text: string | null = null;
      const load = () =>
        (file ||= fetch(url)
          .then((res) => (res.ok ? res.text() : Promise.reject(new Error(`${res.status}`))))
          .then((t) => (text = t))
          .catch((e) => {
            file = null;
            throw e;
          }));
      for (const type of ['pointerenter', 'focus', 'touchstart']) button.addEventListener(type, () => load().catch(() => {}), { passive: true });
      button.addEventListener('click', async () => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error('no clipboard');
          await navigator.clipboard.writeText(text ?? (await load()));
          flashCopied(button);
        } catch {
          window.open(url, '_blank', 'noopener');
        }
      });
    });

    choices.forEach((c, i) => {
      c.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((b) =>
        b.addEventListener('click', () => {
          answers[i] = b.dataset.answer as 'default' | 'other';
          answered = true;
          c.querySelectorAll('[data-answer]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          update();
        }),
      );
    });

    const stepsToggle = document.querySelector<HTMLButtonElement>('[data-steps-toggle]');
    const steps = [...document.querySelectorAll<HTMLDetailsElement>('.timeline details')];
    if (stepsToggle && steps.length) {
      const sync = () => {
        const all = steps.every((d) => d.open);
        stepsToggle.textContent = all ? 'Fold all steps' : 'Open all steps';
        stepsToggle.setAttribute('aria-expanded', String(all));
      };
      stepsToggle.hidden = false;
      stepsToggle.addEventListener('click', () => {
        const open = !steps.every((d) => d.open);
        steps.forEach((d) => (d.open = open));
        sync();
      });
      steps.forEach((d) => d.addEventListener('toggle', sync));
      sync();
    }

    // Mermaid can't lay out a diagram inside a closed <details>, so it loads when the model is first opened.
    const model = document.querySelector<HTMLDetailsElement>('details[data-model]');
    let mermaidLoaded = false;
    function drawDiagrams(root: HTMLElement) {
      if (mermaidLoaded || !root.querySelector('pre.mermaid')) return;
      mermaidLoaded = true;
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(({ default: mermaid }) => {
        mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
        mermaid.run({ nodes: root.querySelectorAll('pre.mermaid') });
      });
    }
    if (model) {
      model.addEventListener('toggle', () => model.open && drawDiagrams(model));
      if (model.open) drawDiagrams(model);
      const fold = model.querySelector<HTMLButtonElement>('[data-model-fold]');
      if (fold) {
        fold.hidden = false;
        fold.addEventListener('click', () => {
          model.open = false;
          model.closest('section')?.scrollIntoView({ block: 'start' });
        });
      }
    }

    const sheet = document.getElementById('toc-sheet') as HTMLDialogElement | null;
    if (sheet) {
      document.querySelectorAll('[data-open-toc]').forEach((b) => b.addEventListener('click', () => sheet.showModal()));
      sheet.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', () => sheet.close()));
      sheet.addEventListener('click', (e) => e.target === sheet && sheet.close());
    }

    const links =[...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')];
    const targets = [...new Set(links.map((a) => a.dataset.toc!))].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const rail = document.querySelector<HTMLElement>('.rail-sticky');
    let frame = 0;
    function mark() {
      frame = 0;
      let current = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top < 140) current = t.id;
      links.forEach((a) => (a.dataset.toc === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      // On a short screen the rail scrolls on its own; keep the marked section in sight.
      const active = rail?.querySelector('a[aria-current]');
      if (rail && active && rail.scrollHeight > rail.clientHeight) {
        const a = active.getBoundingClientRect();
        const r = rail.getBoundingClientRect();
        if (a.bottom > r.bottom - 12) rail.scrollTop += a.bottom - r.bottom + 24;
        else if (a.top < r.top + 12) rail.scrollTop -= r.top - a.top + 24;
      }
    }
    if (targets.length) {
      addEventListener('scroll', () => (frame ||= requestAnimationFrame(mark)), { passive: true });
      mark();
    }
  </script>
</Base>
