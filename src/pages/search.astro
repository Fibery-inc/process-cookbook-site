---
import Base from '../layouts/Base.astro';
import { domains } from '../lib/recipes';
const list = domains();
---
<Base title="Search · Process Cookbook" description="Search the Process Cookbook by process, method, role or domain." current="recipes">
  <section class="section wrap" style="padding-bottom: 80px; max-width: 900px;">
    <h2 style="font-size: 30px; margin-bottom: 16px;">Search</h2>
    <form id="sf" role="search" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
      <label class="sr-only" for="q">Search a process</label>
      <input class="input" id="q" name="q" type="search" autofocus placeholder="A process, a method, a role: cat rescue, six-week cycles, repair orders…" style="flex: 1 1 380px; min-width: 0; height: 52px; font-size: 16px;" />
      <select class="input" id="domain" name="domain" style="height: 52px;">
        <option value="">Any domain</option>
        {list.map((d) => <option value={d}>{d}</option>)}
      </select>
      <button class="btn solid lg" type="submit">Search</button>
    </form>
    <p id="status" class="small muted" style="margin-bottom: 16px;">Type to search, in your own words or any language.</p>
    <div id="results" class="results"></div>
  </section>

  <script>
    import { makeIndex, search } from '../lib/search';
    const FOR: Record<string, string> = { solo: 'for one person', team: 'for a team', company: 'for a company', community: 'for a community' };
    const form = document.getElementById('sf') as HTMLFormElement;
    const q = document.getElementById('q') as HTMLInputElement;
    const domainSel = document.getElementById('domain') as HTMLSelectElement;
    const status = document.getElementById('status')!;
    const results = document.getElementById('results')!;
    let index: ReturnType<typeof makeIndex> | null = null;

    async function load() {
      const docs = await fetch('/search-index.json').then((r) => r.json());
      index = makeIndex(docs);
    }

    function esc(s: string) { return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!)); }

    const requestLink = (text: string) => `<a href="https://github.com/Fibery-inc/process-cookbook/issues/new?labels=recipe%20request&title=Recipe%20request%3A%20${encodeURIComponent(text)}">Request “${esc(text)}”</a>`;
    const resultHtml = (h: any) => `<a class="result" href="/r/${h.id}"><span class="t">${esc(h.title)}</span><span class="s">${esc(h.summary)}</span><span class="m"><span class="tag" data-domain="${esc(h.domain)}">${esc(h.domain)}</span><span>${esc(FOR[h.for] || h.for)}</span></span></a>`;

    function render(text: string, hits: any[], fits: boolean) {
      if (!hits.length) {
        status.textContent = `Nothing for “${text}” yet.`;
        results.innerHTML = `<div class="empty">No recipe matches yet. ${requestLink(text)} and it goes on the board, or <a href="/contribute">write it</a>.</div>`;
        return;
      }
      status.textContent = fits ? `${hits.length} recipe${hits.length === 1 ? '' : 's'} for “${text}”` : `Nothing fits “${text}” closely. The nearest:`;
      results.innerHTML = hits.map(resultHtml).join('') + (fits ? '' : `<div class="empty">Not it? ${requestLink(text)} and it goes on the board, or <a href="/contribute">write it</a>.</div>`);
    }

    // Words answer instantly in the browser; the server adds meaning (other phrasings, other languages) a moment later.
    let pending: ReturnType<typeof setTimeout> | undefined;
    let seq = 0;
    async function byMeaning(text: string, domain: string, mine: number) {
      try {
        const params = new URLSearchParams({ q: text, limit: '20' });
        if (domain) params.set('domain', domain);
        const res = await fetch(`/api/search?${params}`);
        if (!res.ok) throw new Error(`${res.status}`);
        const data = await res.json();
        if (mine === seq) render(text, data.hits || [], !!data.fits);
      } catch {
        if (mine === seq && !results.innerHTML) render(text, [], false);
      }
    }

    function run() {
      if (!index) return;
      const text = q.value.trim();
      const domain = domainSel.value;
      const url = new URL(location.href);
      text ? url.searchParams.set('q', text) : url.searchParams.delete('q');
      domain ? url.searchParams.set('domain', domain) : url.searchParams.delete('domain');
      history.replaceState(null, '', url);
      const mine = ++seq;
      clearTimeout(pending);
      if (!text) { results.innerHTML = ''; status.textContent = 'Type to search, in your own words or any language.'; return; }
      const hits = search(index, text, { domain: domain || undefined, limit: 20 });
      if (hits.length) render(text, hits, true);
      else { status.textContent = `Searching for “${text}”…`; results.innerHTML = ''; }
      pending = setTimeout(() => byMeaning(text, domain, mine), 350);
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); run(); });
    q.addEventListener('input', run);
    domainSel.addEventListener('change', run);
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') || '';
    domainSel.value = params.get('domain') || '';
    load().then(run);
  </script>
</Base>
